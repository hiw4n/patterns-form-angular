{
  "name": "patterns-form-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "__example": "npm run start",
    "start": "ng serve demo",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build checkout-form",
    "build:demo": "ng build demo",
    "test": "npm run test:lib && npm run test:demo",
    "test:lib": "ng test checkout-form --watch=false",
    "test:demo": "ng test demo --watch=false",
    "lint": "npm run lint:lib && npm run lint:demo",
    "lint:lib": "ng lint checkout-form",
    "lint:demo": "ng lint demo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
